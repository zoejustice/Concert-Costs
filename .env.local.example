# Copy this file to .env.local and fill in your Supabase values.
# Get them from: Supabase Dashboard → ConcertCosts project → Connect (or Settings → API Keys)
# - Project URL → NEXT_PUBLIC_SUPABASE_URL
# - Publishable key (or legacy anon public key) → NEXT_PUBLIC_SUPABASE_ANON_KEY
# Do NOT use the service role or secret key here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here
